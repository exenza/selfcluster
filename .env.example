# ---- This node -------------------------------------------------------------
# Short unique name shown in the UI (letters, digits, . _ -).
NODE_ID=nas-01
# How browsers and the other nodes reach this node. No trailing slash.
NODE_URL=http://192.168.1.10:7443

# ---- The cluster (same on every node) ---------------------------------------
# Optional. Leave empty and add this node from Cluster -> Add a node on any existing node.
# Or put one existing node's address here to join at startup (one is enough).
PEERS=
# Shared secret for node-to-node requests and sessions. At least 16 characters.
# Generate one with:  openssl rand -hex 32
CLUSTER_SECRET=

# ---- Sign-in -------------------------------------------------------------------
# Only needed on the FIRST node: these seed the cluster's shared sign-in settings.
# After that, change them in Cluster -> Sign-in settings; nodes you add get them
# from the cluster, and these lines are ignored (with a warning if they differ).
# Built-in account, always the admin role. Use it for the initial setup. Once OIDC is
# configured below, password sign-in is turned off.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Emergency access when the identity provider is down or misconfigured: set this to true
# on one node and restart SelfCluster there. ADMIN_PASSWORD then works on that node again,
# for 1-hour sessions. Remove it once single sign-on works again.
# BREAK_GLASS=false
# How long a sign-in lasts, in hours (default 168 = 7 days).
# SESSION_HOURS=168

# ---- Optional single sign-on (OpenID Connect), first node only ---------------
# Easier: set it up in Cluster -> Sign-in settings, which tests it before saving.
# Register SelfCluster as a confidential client on your identity provider with
# redirect URIs  <NODE_URL>/auth/oidc/callback  for every node, plus one for each
# address in PUBLIC_URLS.
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=selfcluster
# OIDC_CLIENT_SECRET=
# Text on the sign-in button: "Sign in with <OIDC_LABEL>".
# OIDC_LABEL=Authelia
# Roles, highest match wins (comma separated; users match username, email or sub):
#   admin    everything: edit files, shared.env, terminal, new stacks, remove
#   operator start / stop / restart / pull, deploy and down existing stacks
#   viewer   look only: status, compose files, logs (env values masked)
# At least one mapping is required, or OIDC_DEFAULT_ROLE.
# OIDC_ADMIN_GROUPS=homelab-admins
# OIDC_ADMIN_USERS=anna@example.com
# OIDC_OPERATOR_GROUPS=homelab-ops
# OIDC_OPERATOR_USERS=
# OIDC_VIEWER_GROUPS=family
# OIDC_VIEWER_USERS=
# Role for accounts that match nothing: none (refused, the default), viewer, operator or admin.
# OIDC_DEFAULT_ROLE=none
# Defaults: "openid profile email", plus "groups" when OIDC_ALLOWED_GROUPS is set.
# OIDC_SCOPES=openid profile email groups
# OIDC_USERNAME_CLAIM=preferred_username
# Dotted paths work, e.g. realm_access.roles for Keycloak realm roles.
# OIDC_GROUPS_CLAIM=groups
# Other addresses people open SelfCluster at (floating IP name, reverse proxy), comma separated.
# PUBLIC_URLS=https://selfcluster.home.lan

# ---- Paths -------------------------------------------------------------------
# Running compose stacks are found wherever their files are. This folder is where
# "New stack" creates folders and where shared.env is written; compose folders in it
# are listed even if they were never started.
STACKS_DIR=/opt/stacks
PORT=7443
# Host path of the Docker socket. For rootful Podman: /run/podman/podman.sock
DOCKER_SOCKET=/var/run/docker.sock

# ---- Optional floating IP (docker compose --profile vip up -d) ---------------
# The address moves to whichever node is up and has the highest priority.
# VIP_ADDRESS=192.168.1.5/24
# VIP_INTERFACE=eth0
# Different on each node, e.g. 150 / 100 / 50.
# VIP_PRIORITY=100
# Same on every node; keepalived uses the first 8 characters.
# VIP_PASSWORD=change-me
# VIP_ROUTER_ID=51
# Only if your network blocks multicast: the other nodes' LAN IPs, space separated.
# VIP_UNICAST_PEERS=192.168.1.21 192.168.1.30
